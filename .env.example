# Supabase Backend Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Places API for Business Search
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Hunter.io API for Email Enrichment
NEXT_PUBLIC_HUNTER_API_KEY=your_hunter_api_key

# SMTP Email Sending (Outlook/Microsoft 365)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your_outlook_email@example.com
SMTP_PASS=your_outlook_password
